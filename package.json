{
  "name": "hci-portfolio",
  "version": "1.0.0",
  "description": "HCI Process Portfolio for documenting iterative design process",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint src scripts vite.config.ts",
    "preview": "vite preview",
    "analyze:game": "tsx scripts/analysis/analyze_game.ts",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/init.ts --seed-only",
    "db:seed:dry": "tsx src/db/init.ts --dry-run --seed-only",
    "db:schema": "tsx src/db/init.ts --schema-only",
    "db:export:supabase": "tsx src/db/exportSupabaseSql.ts",
    "db:check:supabase": "tsx src/db/checkSupabase.ts",
    "db:check:supabase:catalog": "tsx src/db/checkSupabaseCatalog.ts",
    "db:check:supabase:persistence": "tsx src/db/checkSupabasePersistence.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.38.0",
    "postgres": "^3.4.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
