---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ImageZoom from '../components/ImageZoom.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Gradventure | Evaluation">
    <PageHeader 
        title="Evaluation & Refinement" 
        description="Testing our prototypes with users, gathering feedback, and refining the experience."
    />

    <!-- Usability Testing Section -->
    <Section title="Usability Testing" class="bg-brand-cyan border-y-4 border-black relative overflow-hidden">
        <div class="absolute inset-0 bg-grid-pattern"></div>
        <div class="relative z-10">
            <div class="mb-12 bg-white p-6 border-4 border-black shadow-neo inline-block transform -rotate-1">
                <p class="text-black text-xl font-bold leading-relaxed">
                    We conducted <span class="bg-brand-yellow px-2 py-1 border-2 border-black shadow-neo-inline">3 usability testing sessions</span> with real users to validate our design decisions and identify areas for improvement.
                </p>
            </div>

            <!-- Testing Methodology -->
            <div class="bg-white border-4 border-black p-8 mb-12 shadow-neo transform rotate-1">
                <h3 class="text-3xl font-black mb-6 font-display uppercase border-b-4 border-black pb-2 inline-block">📋 Testing Methodology</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="bg-brand-pink border-4 border-black p-6 shadow-neo transform -rotate-1">
                        <span class="bg-black text-white font-bold text-sm px-2 py-1 uppercase border-2 border-black mb-3 inline-block">Participants</span>
                        <p class="text-black font-bold text-2xl">3 Users</p>
                        <ul class="text-black font-bold text-base mt-4 space-y-2">
                            <li>→ Undergraduate students (Year 2-3)</li>
                            <li>→ Planning to study abroad</li>
                            <li>→ Mixed game experience</li>
                        </ul>
                    </div>
                    <div class="bg-brand-yellow border-4 border-black p-6 shadow-neo transform rotate-1">
                        <span class="bg-black text-white font-bold text-sm px-2 py-1 uppercase border-2 border-black mb-3 inline-block">Format</span>
                        <p class="text-black font-bold text-2xl">Moderated Sessions</p>
                        <ul class="text-black font-bold text-base mt-4 space-y-2">
                            <li>→ Remote video calls</li>
                            <li>→ 30-45 min per session</li>
                            <li>→ Screen recording + notes</li>
                        </ul>
                    </div>
                    <div class="bg-brand-green border-4 border-black p-6 shadow-neo transform -rotate-1">
                        <span class="bg-black text-white font-bold text-sm px-2 py-1 uppercase border-2 border-black mb-3 inline-block">Tasks</span>
                        <p class="text-black font-bold text-2xl">Core Scenarios</p>
                        <ul class="text-black font-bold text-base mt-4 space-y-2">
                            <li>→ Complete first game run</li>
                            <li>→ Navigate to Knowledge Base</li>
                            <li>→ Access Store/Shop</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Participant Profiles -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
                <div class="bg-white border-4 border-black p-6 shadow-neo transform -rotate-1 hover:rotate-0 transition-transform">
                    <div class="flex items-center gap-3 mb-4 border-b-4 border-black pb-3">
                        <span class="bg-brand-pink text-white font-black text-2xl px-3 py-2 border-4 border-black shadow-neo">P1</span>
                        <h4 class="font-black text-lg">Sarah (Year 2)</h4>
                    </div>
                    <div class="space-y-3">
                        <div>
                            <span class="bg-black text-white font-bold text-xs px-2 py-1 uppercase border-2 border-black">Background</span>
                            <p class="text-black font-bold text-sm mt-1">Economics major, casual gamer</p>
                        </div>
                        <div>
                            <span class="bg-black text-white font-bold text-xs px-2 py-1 uppercase border-2 border-black">Goal</span>
                            <p class="text-black font-bold text-sm mt-1">Explore study abroad options</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white border-4 border-black p-6 shadow-neo transform rotate-1 hover:rotate-0 transition-transform">
                    <div class="flex items-center gap-3 mb-4 border-b-4 border-black pb-3">
                        <span class="bg-brand-yellow text-black font-black text-2xl px-3 py-2 border-4 border-black shadow-neo">P2</span>
                        <h4 class="font-black text-lg">Mike (Year 3)</h4>
                    </div>
                    <div class="space-y-3">
                        <div>
                            <span class="bg-black text-white font-bold text-xs px-2 py-1 uppercase border-2 border-black">Background</span>
                            <p class="text-black font-bold text-sm mt-1">CS major, experienced gamer</p>
                        </div>
                        <div>
                            <span class="bg-black text-white font-bold text-xs px-2 py-1 uppercase border-2 border-black">Goal</span>
                            <p class="text-black font-bold text-sm mt-1">Evaluate application feasibility</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white border-4 border-black p-6 shadow-neo transform -rotate-1 hover:rotate-0 transition-transform">
                    <div class="flex items-center gap-3 mb-4 border-b-4 border-black pb-3">
                        <span class="bg-brand-green text-white font-black text-2xl px-3 py-2 border-4 border-black shadow-neo">P3</span>
                        <h4 class="font-black text-lg">Lin (Year 2)</h4>
                    </div>
                    <div class="space-y-3">
                        <div>
                            <span class="bg-black text-white font-bold text-xs px-2 py-1 uppercase border-2 border-black">Background</span>
                            <p class="text-black font-bold text-sm mt-1">Design student, non-gamer</p>
                        </div>
                        <div>
                            <span class="bg-black text-white font-bold text-xs px-2 py-1 uppercase border-2 border-black">Goal</span>
                            <p class="text-black font-bold text-sm mt-1">Learn about application process</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Key Findings Summary -->
            <div class="bg-brand-yellow border-4 border-black p-8 shadow-neo-lg transform -rotate-1">
                <h3 class="text-3xl font-black mb-6 font-display uppercase border-b-4 border-black pb-2 inline-block">🔍 Key Findings</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white border-4 border-black p-4 shadow-neo">
                        <h4 class="font-black text-lg mb-3 border-b-4 border-brand-green pb-1">✅ What Worked Well</h4>
                        <ul class="text-black font-bold space-y-2">
                            <li>→ Intuitive swipe mechanic</li>
                            <li>→ Clear stat visualization</li>
                            <li>→ Engaging visual style</li>
                            <li>→ Tutorial was helpful</li>
                        </ul>
                    </div>
                    <div class="bg-white border-4 border-black p-4 shadow-neo">
                        <h4 class="font-black text-lg mb-3 border-b-4 border-brand-pink pb-1">⚠️ Issues Identified</h4>
                        <ul class="text-black font-bold space-y-2">
                            <li>→ Stat preview during swipe confusing</li>
                            <li>→ Knowledge base hard to find</li>
                            <li>→ Game over felt abrupt</li>
                            <li>→ Unclear win condition</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </Section>

    <!-- Iterative Refinement Section -->
    <Section title="Iterative Refinement" class="bg-brand-orange border-y-4 border-black relative overflow-hidden">
        <div class="absolute inset-0 bg-grid-pattern"></div>
        <div class="relative z-10">
            <div class="mb-12 bg-white p-6 border-4 border-black shadow-neo inline-block transform -rotate-1">
                <p class="text-black text-xl font-bold leading-relaxed">
                    Based on user feedback, we made <span class="bg-brand-yellow px-2 py-1 border-2 border-black shadow-neo-inline">3 major iterations</span> to improve the user experience.
                </p>
            </div>

            <div class="space-y-16">
                <!-- Iteration 1: Knowledge Base -->
                <div class="bg-white border-4 border-black p-8 shadow-neo-lg transform rotate-1">
                    <div class="flex items-center gap-4 mb-6 border-b-4 border-black pb-4">
                        <span class="bg-brand-cyan text-black font-black text-3xl px-4 py-2 border-4 border-black shadow-neo">01</span>
                        <h3 class="text-3xl font-black uppercase font-display">Knowledge Base: Combating Fragmented Knowledge</h3>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <div class="mb-6">
                                <h4 class="font-black text-xl uppercase mb-3 border-b-4 border-brand-pink pb-1 inline-block bg-brand-pink px-3 py-1 border-2 border-black shadow-neo">❌ Before (Issue)</h4>
                                <p class="text-black font-bold text-lg mt-3 leading-relaxed">
                                    Players received fragmented knowledge pieces across cards but had <strong class="bg-brand-pink px-2 py-1 border-2 border-black shadow-neo-inline">no way to review or synthesize</strong> what they learned.
                                </p>
                            </div>

                            <div>
                                <h4 class="font-black text-xl uppercase mb-3 border-b-4 border-brand-green pb-1 inline-block bg-brand-green px-3 py-1 border-2 border-black shadow-neo">✅ After (Solution)</h4>
                                <p class="text-black font-bold text-lg mt-3 leading-relaxed">
                                    Added <strong class="bg-brand-cyan px-2 py-1 border-2 border-black shadow-neo-inline">📚 GUIDE knowledge base</strong> with comprehensive study abroad info, accessible from game screen and game over screen.
                                </p>
                                <div class="mt-4 bg-gray-100 border-4 border-black p-4 shadow-neo transform -rotate-1">
                                    <div class="space-y-2 font-mono text-sm">
                                        <p><span class="bg-brand-cyan px-2 py-1 border-2 border-black font-black">Interface:</span> KnowledgeEntry</p>
                                        <p class="pl-4">Fields: identifier, category, title, content, tags</p>
                                        <p class="pl-4">Categories: application, visa, preparation</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-brand-cyan border-4 border-black p-6 shadow-neo transform -rotate-1 flex flex-col justify-center">
                            <h4 class="font-black text-xl uppercase mb-4 border-b-4 border-black pb-2">📊 Impact</h4>
                            <ul class="text-black font-bold text-lg space-y-3">
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-accent text-2xl">→</span>
                                    <span>Users now have <strong class="bg-white px-2 py-1 border-2 border-black shadow-neo-inline">centralized knowledge repository</strong></span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-accent text-2xl">→</span>
                                    <span>Can review study abroad requirements anytime</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-accent text-2xl">→</span>
                                    <span>Addresses [R3]: Real-world bridge to preparation</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Iteration 2: Gameplay Duration Optimization -->
                <div class="bg-white border-4 border-black p-8 shadow-neo-lg transform -rotate-1">
                    <div class="flex items-center gap-4 mb-6 border-b-4 border-black pb-4">
                        <span class="bg-brand-yellow text-black font-black text-3xl px-4 py-2 border-4 border-black shadow-neo">02</span>
                        <h3 class="text-3xl font-black uppercase font-display">Gameplay Duration: Optimizing for Fragmented Time</h3>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <div class="mb-6">
                                <h4 class="font-black text-xl uppercase mb-3 border-b-4 border-brand-pink pb-1 inline-block bg-brand-pink px-3 py-1 border-2 border-black shadow-neo">❌ Before (Issue)</h4>
                                <p class="text-black font-bold text-lg mt-3 leading-relaxed">
                                    Users reported <strong class="bg-brand-pink px-2 py-1 border-2 border-black shadow-neo-inline">single playthrough took ~5 minutes</strong>. User feedback: "Too long, I need shorter sessions."
                                </p>

                                <div class="mt-4 bg-brand-yellow border-2 border-black p-3 shadow-neo transform -rotate-1">
                                    <div class="flex items-start gap-2">
                                        <span class="text-black font-black text-base">💡</span>
                                        <div>
                                            <p class="text-black font-black text-sm mb-1">Root Cause: Mental Fatigue</p>
                                            <p class="text-black font-bold text-xs">High cognitive load from continuous decision-making (tracking 4 stats while swiping) caused exhaustion after ~5 minutes.</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 bg-gray-100 border-4 border-black p-4 shadow-neo transform rotate-1">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="font-black text-sm">Before: 5 min</span>
                                        <span class="font-black text-sm">After: 1.5-2 min</span>
                                    </div>
                                    <div class="flex gap-2">
                                        <div class="flex-1 bg-brand-pink border-2 border-black h-8 flex items-center justify-center">
                                            <span class="font-black text-xs">██████████████████</span>
                                        </div>
                                        <div class="flex-1 bg-brand-green border-2 border-black h-8 flex items-center justify-center">
                                            <span class="font-black text-xs">██████</span>
                                        </div>
                                    </div>
                                    <div class="flex gap-2 mt-1">
                                        <div class="flex-1 text-center font-black text-xs">Before</div>
                                        <div class="flex-1 text-center font-black text-xs">After</div>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <h4 class="font-black text-xl uppercase mb-3 border-b-4 border-brand-green pb-1 inline-block bg-brand-green px-3 py-1 border-2 border-black shadow-neo">✅ After (Solution)</h4>
                                <p class="text-black font-bold text-lg mt-3 leading-relaxed">
                                    Reduced cards per year from <strong class="bg-brand-yellow px-2 py-1 border-2 border-black shadow-neo-inline">~20 to 7</strong>, optimized pacing to 7s per card. Total: <strong class="bg-brand-green px-2 py-1 border-2 border-black shadow-neo-inline">1.5-2 minutes</strong>.
                                </p>
                                <div class="mt-4 bg-gray-100 border-4 border-black p-4 shadow-neo transform -rotate-1">
                                    <div class="space-y-2 font-mono text-sm">
                                        <p><span class="bg-brand-yellow px-2 py-1 border-2 border-black font-black">CARDS_PER_YEAR</span> 7 (was ~20)</p>
                                        <p><span class="bg-brand-yellow px-2 py-1 border-2 border-black font-black">AVG_TIME_PER_CARD</span> 7 seconds</p>
                                        <p><span class="bg-brand-yellow px-2 py-1 border-2 border-black font-black">RESULT</span> 7 × 3 years × 7s = ~2 min</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-brand-yellow border-4 border-black p-6 shadow-neo transform rotate-1 flex flex-col justify-center">
                            <h4 class="font-black text-xl uppercase mb-4 border-b-4 border-black pb-2">📊 Impact</h4>
                            <ul class="text-black font-bold text-lg space-y-3">
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-accent text-2xl">→</span>
                                    <span><strong class="bg-white px-2 py-1 border-2 border-black shadow-neo-inline">60% reduction</strong> in playtime (5min → 2min)</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-accent text-2xl">→</span>
                                    <span>Fits [R1]: Fragmented-time-friendly sessions</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-brand-accent text-2xl">→</span>
                                    <span>Users can complete quick games between classes</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Iteration 3: UI Visual Refinement A/B Test -->
                <div class="bg-white border-4 border-black p-8 shadow-neo-lg transform rotate-1">
                    <div class="flex items-center gap-4 mb-6 border-b-4 border-black pb-4">
                        <span class="bg-brand-accent text-white font-black text-3xl px-4 py-2 border-4 border-black shadow-neo">03</span>
                        <h3 class="text-3xl font-black uppercase font-display">UI Visual Refinement: A/B Test</h3>
                    </div>

                    <div class="mb-6 bg-brand-yellow border-4 border-black p-4 shadow-neo transform -rotate-1">
                        <p class="text-black font-bold text-lg">
                            <strong class="bg-black text-white px-2 py-1 mr-2">🔬 Method</strong>
                            Simultaneously deployed <strong class="bg-brand-pink px-2 py-1 border-2 border-black shadow-neo-inline">two UI versions</strong> to users and gathered feedback on visual preference.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <div class="mb-6">
                                <h4 class="font-black text-xl uppercase mb-3 border-b-4 border-brand-pink pb-1 inline-block bg-brand-pink px-3 py-1 border-2 border-black shadow-neo">Version A: P5 Style UI</h4>
                                <p class="text-black font-bold text-base mt-3 leading-relaxed">
                                    Processing.js-inspired aesthetic with generative elements and dynamic visual effects.
                                </p>
                                <div class="mt-3 bg-brand-yellow border-2 border-black p-3 shadow-neo transform -rotate-1">
                                    <p class="text-black font-bold text-sm">
                                        <strong class="underline">User Feedback:</strong> "Too aggressive visually for extended gameplay sessions - the generative effects feel overwhelming after a few minutes."
                                    </p>
                                </div>
                                <div class="mt-4">
                                    <button
                                        onclick="document.getElementById('version-a-modal').classList.remove('hidden')"
                                        class="w-full bg-brand-pink border-4 border-black px-6 py-3 font-black text-lg shadow-neo transform -rotate-1 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-neo-none transition-all cursor-pointer"
                                    >
                                        👁️ View Screenshot
                                    </button>
                                    <!-- Modal -->
                                    <div id="version-a-modal" class="hidden fixed inset-0 bg-black bg-opacity-80 z-50 flex items-center justify-center p-4" onclick="document.getElementById('version-a-modal').classList.add('hidden')">
                                        <div class="bg-white border-4 border-black p-4 shadow-neo-lg max-w-4xl max-h-[90vh] overflow-auto" onclick="event.stopPropagation()">
                                            <div class="flex justify-between items-center mb-4 border-b-4 border-black pb-2">
                                                <h4 class="font-black text-xl">Version A: P5 Style UI</h4>
                                                <button
                                                    onclick="document.getElementById('version-a-modal').classList.add('hidden')"
                                                    class="bg-brand-pink border-2 border-black px-4 py-2 font-black hover:bg-brand-yellow transition-colors"
                                                >
                                                    ✕ Close
                                                </button>
                                            </div>
                                            <img src={`${base}ui/p5.png`} alt="Version A: P5 Style UI" class="w-full h-auto" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <h4 class="font-black text-xl uppercase mb-3 border-b-4 border-brand-cyan pb-1 inline-block bg-brand-cyan px-3 py-1 border-2 border-black shadow-neo">Version B: Neo-Brutalist</h4>
                                <p class="text-black font-bold text-base mt-3 leading-relaxed">
                                    Bold borders, heavy shadows, and vibrant colors create a distinctive playful aesthetic. Clear visual hierarchy and consistent design language enhance readability.
                                </p>
                                <div class="mt-3 bg-brand-green border-2 border-black p-3 shadow-neo transform rotate-1">
                                    <p class="text-black font-bold text-sm">
                                        <strong class="underline">User Feedback:</strong> "Engaging and fun - the bold style makes it feel like a game while staying readable for long sessions."
                                    </p>
                                </div>
                                <div class="mt-4">
                                    <button
                                        onclick="document.getElementById('version-b-modal').classList.remove('hidden')"
                                        class="w-full bg-brand-cyan border-4 border-black px-6 py-3 font-black text-lg shadow-neo transform rotate-1 hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-neo-none transition-all cursor-pointer"
                                    >
                                        👁️ View Screenshot
                                    </button>
                                    <!-- Modal -->
                                    <div id="version-b-modal" class="hidden fixed inset-0 bg-black bg-opacity-80 z-50 flex items-center justify-center p-4" onclick="document.getElementById('version-b-modal').classList.add('hidden')">
                                        <div class="bg-white border-4 border-black p-4 shadow-neo-lg max-w-4xl max-h-[90vh] overflow-auto" onclick="event.stopPropagation()">
                                            <div class="flex justify-between items-center mb-4 border-b-4 border-black pb-2">
                                                <h4 class="font-black text-xl">Version B: Neo-Brutalist</h4>
                                                <button
                                                    onclick="document.getElementById('version-b-modal').classList.add('hidden')"
                                                    class="bg-brand-cyan border-2 border-black px-4 py-2 font-black hover:bg-brand-yellow transition-colors"
                                                >
                                                    ✕ Close
                                                </button>
                                            </div>
                                            <img src={`${base}ui/neo.png`} alt="Version B: Neo-Brutalist UI" class="w-full h-auto" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-brand-accent border-4 border-black p-6 shadow-neo transform -rotate-1 flex flex-col justify-center">
                            <h4 class="font-black text-xl uppercase mb-4 border-b-4 border-black pb-2 text-white">🏆 Winner: Version B</h4>
                            <div class="space-y-4">
                                <div class="bg-black border-2 border-white p-3 shadow-neo">
                                    <p class="text-brand-yellow font-black text-sm mb-2">User Preference</p>
                                    <p class="text-white font-bold text-base">3 out of 3 users chose Version B</p>
                                </div>
                                <div class="bg-white border-2 border-black p-3 shadow-neo">
                                    <p class="text-black font-black text-sm mb-2">Key Feedback</p>
                                    <ul class="text-black font-bold text-sm space-y-2">
                                        <li>"Version B is more engaging and fun to play"</li>
                                        <li>"The bold style makes it feel like a real game"</li>
                                        <li>"Version A's effects are too overwhelming for long sessions"</li>
                                    </ul>
                                </div>
                                <div class="bg-brand-yellow border-2 border-black p-3 shadow-neo">
                                    <p class="text-black font-bold text-sm">
                                        <strong>✅ Decision:</strong> Adopted neo-brutalist design as final visual style
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Section>

    <!-- Requirements Validation Section -->
    <Section title="Requirements Validation: Did We Meet Our Goals?" class="bg-brand-purple border-y-4 border-black relative overflow-hidden" style="background-color: #D0BFFF;">
        <div class="absolute inset-0 bg-grid-pattern"></div>

        <div class="relative z-10 mb-12">
            <div class="bg-white p-6 border-4 border-black shadow-neo-lg transform -rotate-1 max-w-4xl">
                <p class="text-black text-xl font-bold leading-relaxed mb-4">
                    Through usability testing and iterative refinement, we validated that <span class="bg-brand-cyan px-2 py-1 border-2 border-black shadow-neo-inline">all 3 core requirements</span> were successfully implemented and effective.
                </p>
                <p class="text-black font-bold text-lg">
                    Each requirement was measured against specific metrics from real user sessions.
                </p>
            </div>
        </div>

        <div class="space-y-12 relative z-10">
            <!-- R1 Validation -->
            <div class="bg-white border-4 border-black p-8 shadow-neo-lg transform rotate-1 hover:rotate-0 transition-all">
                <div class="flex items-start gap-6 mb-6">
                    <div class="bg-brand-cyan text-black font-black text-4xl px-5 py-3 border-4 border-black shadow-neo flex-shrink-0 transform -rotate-3">
                        R1
                    </div>
                    <div class="flex-1">
                        <div class="flex items-center gap-3 mb-3">
                            <span class="bg-black text-white font-bold px-2 py-1 text-xs uppercase border-2 border-black">Implemented via [DG1] → [SF1]</span>
                            <span class="text-brand-ccent text-xl">⚡</span>
                        </div>
