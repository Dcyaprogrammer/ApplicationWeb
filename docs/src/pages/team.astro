---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import TeamMember from '../components/TeamMember.astro';

// Team member data
const teamMembers = [
	{
		name: "Chengyang Du",
		id: "2360818",
		avatar: "avatar-chengyang.jpg",
		role: "Team Member",
		bio: "Contributing to the design and development of Gradventure, focusing on creating an engaging experience for students preparing for study abroad applications.",
		skills: ["Design", "Development", "Research"],
        color: "bg-brand-pink"
	},
	{
		name: "Gulong Sun",
		id: "2362272",
		avatar: "avatar-gulong.jpg",
		role: "Team Member",
		bio: "I am a third-year undergraduate student majoring in ICS. I have taken several programming and algorithms courses in the past. I am really looking forward to taking CPT208 and collaborating with everyone in the class.",
		skills: ["Design", "Development", "Research"],
        color: "bg-brand-yellow"
	},
	{
		name: "Yanhan Jin",
		id: "2362139",
		avatar: "avatar-yanhan.jpg",
		role: "Team Member",
		bio: "I am a third-year undergraduate student at Xi'an Jiaotong-Liverpool University, majoring in Information and Computing Science. During my academic journey, I have gained experience in programming, data processing, and algorithm design. I am excited to collaborate with my team members and contribute to meaningful work together.",
		skills: ["Design", "Development", "Research"],
        color: "bg-brand-green"
	},
	{
		name: "Yixuan Zheng",
		id: "2362357",
		avatar: "avatar-yixuan.jpg",
		role: "Team Member",
		bio: "As a third-year ICS student at Xi'an Jiaotong-Liverpool University, I'm particularly interested in how computing can be applied to real-world problems. I've explored areas like data analysis and machine learning, and I enjoy the process of turning data into useful insights. I'm looking forward to learning from my teammates and contributing to our work together.",
		skills: ["Design", "Development", "Research"],
        color: "bg-brand-cyan"
	}
];
---

<Layout title="Gradventure | Team">
	<PageHeader
		title="Meet The Team"
		description="The four designers and developers behind Gradventure."
	/>

	<Section title="Our Team">
		<div class="mb-12 bg-white p-6 border-4 border-black shadow-neo inline-block transform -rotate-1">
            <p class="text-black text-xl font-bold leading-relaxed">
                We are a group of four students with diverse backgrounds in design, development, and education.
                Together, we're building <span class="bg-black text-white px-2 py-1 uppercase tracking-widest">Gradventure</span> — an engaging platform
                to help students navigate the study abroad application process through gamification.
            </p>
        </div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-12">
			{teamMembers.map((member, i) => (
				<div class={`${member.color} p-4 border-4 border-black shadow-neo-lg transform ${i % 2 === 0 ? 'rotate-1' : '-rotate-1'} hover:rotate-0 hover:translate-x-[4px] hover:translate-y-[4px] hover:shadow-neo-none transition-all`}>
					<TeamMember {...member} />
				</div>
			))}
		</div>
	</Section>

	<!-- NEW SECTION: Individual Contributions -->
	<Section title="Individual Contributions" class="bg-brand-yellow border-y-4 border-black relative overflow-hidden">
		<div class="absolute inset-0 bg-grid-pattern"></div>
		<div class="relative z-10">
			<div class="mb-12 bg-white p-6 border-4 border-black shadow-neo inline-block transform -rotate-1">
				<p class="text-black text-xl font-bold leading-relaxed">
					Each team member contributed across multiple dimensions of the project. Below is a detailed breakdown of individual responsibilities.
				</p>
			</div>

			<!-- Contributions Table -->
			<div class="bg-white border-4 border-black p-8 shadow-neo-lg transform rotate-1 overflow-x-auto">
				<table class="w-full border-collapse">
					<thead>
						<tr class="bg-black text-white">
							<th class="border-4 border-white font-black text-left p-4 uppercase text-sm">Team Member</th>
							<th class="border-4 border-white font-black text-left p-4 uppercase text-sm">Code</th>
							<th class="border-4 border-white font-black text-left p-4 uppercase text-sm">UI Design</th>
							<th class="border-4 border-white font-black text-left p-4 uppercase text-sm">Content</th>
							<th class="border-4 border-white font-black text-left p-4 uppercase text-sm">Testing</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td class="border-4 border-black p-4 bg-brand-pink">
								<div class="font-black text-lg">Chengyang Du</div>
								<div class="text-sm font-bold">ID: 2360818</div>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Game engine architecture</li>
									<li>→ Card runtime system</li>
									<li>→ Supabase integration</li>
									<li>→ State management (Zustand)</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Neo-brutalism theme</li>
									<li>→ GameScreen component</li>
									<li>→ Auth modal design</li>
									<li>→ Animation patterns</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Card content (Year 1)</li>
									<li>→ Game balance tuning</li>
									<li>→ Tutorial flow</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ User testing sessions</li>
									<li>→ Bug triaging</li>
									<li>→ Performance optimization</li>
								</ul>
							</td>
						</tr>
						<tr>
							<td class="border-4 border-black p-4 bg-brand-yellow">
								<div class="font-black text-lg">Gulong Sun</div>
								<div class="text-sm font-bold">ID: 2362272</div>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Database schema design</li>
										<li>→ Data utility scripts</li>
									<li>→ Authentication flow</li>
									<li>→ Deployment scripts</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Home page layout</li>
									<li>→ StoreScreen UI</li>
									<li>→ Responsive design</li>
									<li>→ Color system</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Card content (Year 2)</li>
									<li>→ Knowledge base articles</li>
									<li>→ Store rewards design</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-year-1">
									<li>→ QA testing</li>
									<li>→ Cross-browser testing</li>
									<li>→ Edge case documentation</li>
								</ul>
							</td>
						</tr>
						<tr>
							<td class="border-4 border-black p-4 bg-brand-green">
								<div class="font-black text-lg">Yanhan Jin</div>
								<div class="text-sm font-bold">ID: 2362139</div>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ KnowledgeBaseScreen</li>
									<li>→ Search/filter logic</li>
									<li>→ Currency system</li>
									<li>→ Achievement unlocks</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Knowledge base UI</li>
									<li>→ Card visual design</li>
									<li>→ Icon/graphic assets</li>
									<li>→ Portfolio site design</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Card content (Year 3)</li>
									<li>→ Educational content research</li>
									<li>→ Achievement definitions</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Content accuracy review</li>
									<li>→ User interview analysis</li>
									<li>→ Feedback synthesis</li>
								</ul>
							</td>
						</tr>
						<tr>
							<td class="border-4 border-black p-4 bg-brand-cyan">
								<div class="font-black text-lg">Yixuan Zheng</div>
								<div class="text-sm font-bold">ID: 2362357</div>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Data persistence layer</li>
									<li>→ Progress tracking</li>
									<li>→ Analytics integration</li>
									<li>→ Error handling</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Portfolio site (Astro)</li>
									<li>→ Wireframe diagrams</li>
									<li>→ Crazy Eights sketches</li>
									<li>→ Presentation slides</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Special event cards</li>
									<li>→ Interview questions</li>
									<li>→ User personas (Jason)</li>
								</ul>
							</td>
							<td class="border-4 border-black p-4">
								<ul class="text-sm font-bold space-y-1">
									<li>→ Usability test moderation</li>
									<li>→ Data analysis</li>
									<li>→ Iteration planning</li>
								</ul>
							</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Additional Notes -->
			<div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8">
				<div class="bg-white border-4 border-black p-6 shadow-neo transform -rotate-1">
					<h4 class="text-xl font-black uppercase mb-4 border-b-4 border-black pb-2">🤝 Collaboration Tools</h4>
					<ul class="text-black font-bold space-y-2">
						li>→ GitHub (Code + Issue tracking)</li>
						<li>→ Figma (Design collaboration)</li>
						<li>→ Notion (Documentation)</li>
						<li>→ Discord (Communication)</li>
					</ul>
				</div>
				<div class="bg-white border-4 border-black p-6 shadow-neo transform rotate-1">
					<h4 class="text-xl font-black uppercase mb-4 border-b-4 border-black pb-2">⚖️ Work Distribution</h4>
					<p class="text-black font-bold text-base leading-relaxed">
						All team members contributed to all major phases. Roles were flexible based on individual strengths and project needs. Decisions were made collectively through regular standups and design reviews.
					</p>
				</div>
			</div>
		</div>
	</Section>
</Layout>
