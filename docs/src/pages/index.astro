---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';

const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
---

<Layout title="Gradventure | Home">
    <Hero
        title="Gradventure"
        subtitle="A process portfolio documenting the iterative design journey of our game-based study abroad application."
        tag="Course Project 2026"
        primaryAction={{ text: "View Research", href: `${normalizedBase}research/` }}
        secondaryAction={{ text: "View Prototypes", href: `${normalizedBase}prototypes/` }}
    />

    <Section title="Design Journey" subtitle="From initial concepts to final validation.">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <div class="bg-brand-yellow p-4 border-4 border-black shadow-neo transform -rotate-1 hover:rotate-0 transition-transform">
                <Card
                    title="Brainstorming"
                    body="Motivation, problem definition and user personas."
                    href={`${normalizedBase}brainstorm/`}
                    icon="💡"
                />
            </div>
            <div class="bg-brand-pink p-4 border-4 border-black shadow-neo transform rotate-1 hover:rotate-0 transition-transform">
                <Card 
                    title="User Research" 
                    body="Stakeholder consultation, survey & interview results, user journey maps, and key requirements."
                    href={`${normalizedBase}research/`}
                    icon="🔍"
                />
            </div>
            <div class="bg-brand-green p-4 border-4 border-black shadow-neo transform -rotate-2 hover:rotate-0 transition-transform">
                <Card 
                    title="Design Journey" 
                    body="Design iterations, wireframing, and UI styling decisions."
                    href={`${normalizedBase}design/`}
                    icon="🎨"
                />
            </div>
            <div class="bg-brand-cyan p-4 border-4 border-black shadow-neo transform rotate-2 hover:rotate-0 transition-transform">
                <Card 
                    title="Prototypes" 
                    body="Low-fidelity to high-fidelity interactive prototypes."
                    href={`${normalizedBase}prototypes/`}
                    icon="📱"
                />
            </div>
            <div class="bg-brand-orange p-4 border-4 border-black shadow-neo transform -rotate-1 hover:rotate-0 transition-transform">
                <Card 
                    title="Evaluation" 
                    body="User testing sessions, feedback analysis, and design refinements."
                    href={`${normalizedBase}evaluation/`}
                    icon="🧪"
                />
            </div>
            <div class="bg-[#A8A6FF] p-4 border-4 border-black shadow-neo transform rotate-1 hover:rotate-0 transition-transform">
                <Card
                    title="About The Team"
                    body="Meet the designers and developers behind this project."
                    href={`${normalizedBase}team/`}
                    icon="👥"
                />
            </div>
        </div>
    </Section>

    <Section title="Project Timeline">
        <div class="relative max-w-4xl mx-auto">
            <!-- Timeline line -->
            <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-[4px] bg-black md:-translate-x-[2px]"></div>

            <div class="space-y-12">
                <!-- Phase 1 -->
                <div class="relative flex items-center md:justify-center">
                    <div class="absolute left-8 md:left-1/2 w-6 h-6 bg-brand-pink border-4 border-black md:-translate-x-1/2 rounded-full z-10"></div>
                    <div class="ml-20 md:ml-0 md:w-1/2 md:pr-16 md:text-right w-full">
                        <span class="bg-white text-black font-bold px-2 py-1 text-sm uppercase border-2 border-black inline-block mb-2 shadow-neo">Weeks 2-3</span>
                        <h3 class="text-black font-black text-2xl uppercase font-display border-b-4 border-black pb-1 inline-block">Research & Ideation</h3>
                        <p class="text-black font-bold text-lg mt-4 bg-white border-2 border-black p-4 shadow-neo">Problem definition, preliminary research, initial concept development</p>
                    </div>
                </div>

                <!-- Phase 2 -->
                <div class="relative flex items-center md:justify-center md:flex-row-reverse">
                    <div class="absolute left-8 md:left-1/2 w-6 h-6 bg-brand-yellow border-4 border-black md:-translate-x-1/2 rounded-full z-10"></div>
                    <div class="ml-20 md:ml-0 md:w-1/2 md:pl-16 w-full">
                        <span class="bg-white text-black font-bold px-2 py-1 text-sm uppercase border-2 border-black inline-block mb-2 shadow-neo">Weeks 4-5</span>
                        <h3 class="text-black font-black text-2xl uppercase font-display border-b-4 border-black pb-1 inline-block">User Research & Requirements</h3>
                        <p class="text-black font-bold text-lg mt-4 bg-white border-2 border-black p-4 shadow-neo">Persona creation, user journey mapping, interviews & questionnaires, requirements definition</p>
                    </div>
                </div>

                <!-- Phase 3 -->
                <div class="relative flex items-center md:justify-center">
                    <div class="absolute left-8 md:left-1/2 w-6 h-6 bg-brand-green border-4 border-black md:-translate-x-1/2 rounded-full z-10"></div>
                    <div class="ml-20 md:ml-0 md:w-1/2 md:pr-16 md:text-right w-full">
                        <span class="bg-white text-black font-bold px-2 py-1 text-sm uppercase border-2 border-black inline-block mb-2 shadow-neo">Weeks 6-7</span>
                        <h3 class="text-black font-black text-2xl uppercase font-display border-b-4 border-black pb-1 inline-block">Prototyping</h3>
                        <p class="text-black font-bold text-lg mt-4 bg-white border-2 border-black p-4 shadow-neo">Low-fidelity wireframes, high-fidelity prototypes, interactive mockups</p>
                    </div>
                </div>

                <!-- Phase 4 -->
                <div class="relative flex items-center md:justify-center md:flex-row-reverse">
                    <div class="absolute left-8 md:left-1/2 w-6 h-6 bg-brand-cyan border-4 border-black md:-translate-x-1/2 rounded-full z-10"></div>
                    <div class="ml-20 md:ml-0 md:w-1/2 md:pl-16 w-full">
                        <span class="bg-white text-black font-bold px-2 py-1 text-sm uppercase border-2 border-black inline-block mb-2 shadow-neo">Weeks 8-9</span>
                        <h3 class="text-black font-black text-2xl uppercase font-display border-b-4 border-black pb-1 inline-block">Evaluation & Iteration</h3>
                        <p class="text-black font-bold text-lg mt-4 bg-white border-2 border-black p-4 shadow-neo">Usability testing, feedback analysis, design iterations, refinements</p>
                    </div>
                </div>

                <!-- Phase 5 -->
                <div class="relative flex items-center md:justify-center">
                    <div class="absolute left-8 md:left-1/2 w-6 h-6 bg-brand-accent border-4 border-black md:-translate-x-1/2 rounded-full z-10"></div>
                    <div class="ml-20 md:ml-0 md:w-1/2 md:pr-16 md:text-right w-full">
                        <span class="bg-white text-black font-bold px-2 py-1 text-sm uppercase border-2 border-black inline-block mb-2 shadow-neo">Week 10</span>
                        <h3 class="text-black font-black text-2xl uppercase font-display border-b-4 border-black pb-1 inline-block">Final Closeout & Reflection</h3>
                        <p class="text-black font-bold text-lg mt-4 bg-white border-2 border-black p-4 shadow-neo">Final documentation, portfolio completion, project reflection</p>
                    </div>
                </div>
            </div>
        </div>
    </Section>

    <Section class="bg-brand-yellow border-y-4 border-black relative overflow-hidden">
        <div class="absolute inset-0 bg-grid-pattern"></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center relative z-10">
            <div class="bg-white border-4 border-black p-8 shadow-neo-lg">
                <h2 class="text-4xl font-black tracking-tighter mb-6 font-display uppercase">The Mission</h2>
                <p class="text-black font-bold leading-relaxed mb-6 text-lg">
                    <span class="bg-black text-white px-2 py-1 mr-1">GRADVENTURE</span> is an engaging web application that gamifies the study abroad preparation process for students. By combining educational content with game mechanics, we aim to make learning about international education accessible and fun.
                </p>
                <a href={`${normalizedBase}brainstorm/`} class="inline-block border-b-4 border-black pb-1 hover:bg-brand-accent hover:text-black hover:border-transparent transition-all font-display font-black text-xl">Read our Problem Statement →</a>
            </div>
            <div class="aspect-square bg-white border-4 border-black flex items-center justify-center relative overflow-hidden shadow-neo-lg group">
                <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
                <img 
                    src={`${normalizedBase}app-qr.png`} 
                    alt="Scan to play Gradventure" 
                    class="w-3/4 h-3/4 object-contain relative z-10 group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute bottom-4 bg-brand-yellow border-2 border-black px-3 py-1 font-bold text-sm transform -rotate-2 z-20">
                    SCAN TO PLAY
                </div>
            </div>
        </div>
    </Section>
</Layout>
